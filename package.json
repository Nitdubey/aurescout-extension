{
  "name": "aurescout-extension",
  "description": "AureScout Chrome Extension — AI Job Matcher, ATS Scanner & LinkedIn Copilot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
