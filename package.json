    "compile": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
